{
  "name": "ik-dsh-ima",
  "version": "1.12.0",
  "description": "腾讯ima知识库接入 DeepSeek Harness：侧边栏浏览、跨库搜正文、上传文件（能读也能写）",
  "main": "lib/index.js",
  "icon": "assets/logo-256.png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikevss/dsh-ima.git",
    "directory": "."
  },
  "homepage": "https://github.com/ikevss/dsh-ima#readme",
  "bugs": {
    "url": "https://github.com/ikevss/dsh-ima/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "ima",
    "knowledge-base",
    "plugin",
    "tencent"
  ],
  "author": "ikevss",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "ima",
    "tencent",
    "knowledge-base",
    "plugin"
  ],
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node test/smoke.js",
    "verify": "node test/verify-package.js",
    "prepublishOnly": "node test/verify-package.js"
  },
  "devDependencies": {
    "@open-file-viewer/core": "1.0.0",
    "esbuild": "^0.24.0"
  }
}
